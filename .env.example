# Ecossistema Viral — variáveis de ambiente
# O deploy/install.sh gera este arquivo automaticamente como .env.
# Copie manualmente só se quiser ajustar antes: cp .env.example .env

# Caminhos (ajustados pelo instalador)
VIRAL_ROOT=/www/wwwroot/viral.vr766.com
VIRAL_STORAGE=/www/wwwroot/viral.vr766.com/fabrica_clips
VIRAL_FRONTEND=/www/wwwroot/viral.vr766.com/frontend_dist

# Segurança / limites
SECRET_KEY=troque-por-um-valor-aleatorio
MAX_UPLOAD_MB=1024
VIRAL_WORKERS=2

# Gunicorn
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
LOG_LEVEL=info

# Binários
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp

# Chaves de API (opcional — o ideal é cadastrar pela aba "Central de APIs")
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# ELEVENLABS_API_KEY=
