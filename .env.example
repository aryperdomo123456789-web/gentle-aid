# Ecossistema Viral — variáveis de ambiente
# O deploy/install.sh gera este arquivo automaticamente como .env.
# Copie manualmente só se quiser ajustar antes: cp .env.example .env

# Caminhos (ajustados pelo instalador)
VIRAL_ROOT=/www/wwwroot/viral.vr766.com
VIRAL_STORAGE=/www/wwwroot/viral.vr766.com/fabrica_clips
VIRAL_FRONTEND=/www/wwwroot/viral.vr766.com/frontend_dist

# Segurança / limites
# Gere SECRET_KEY com pelo menos 32 bytes aleatórios; nunca commite o valor real.
SECRET_KEY=
# Primeiro boot: obrigatórios somente quando o banco auth ainda estiver vazio.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Mago
# Conta demo é opcional e deve ser criada com senha própria forte.
# DEMO_EMAIL=
# DEMO_PASSWORD=
# DEMO_NAME=Operador
MAX_UPLOAD_MB=1024
VIRAL_WORKERS=2

# API pública — limites conservadores por consumidor (ajuste por plano)
API_REQUESTS_PER_MINUTE=60
API_JOBS_PER_DAY=100
API_AUDIO_SECONDS_PER_DAY=3600
API_COST_UNITS_PER_DAY=3600
API_MAX_CONCURRENT_JOBS=2
API_QUEUE_LEASE_SECONDS=900
API_QUEUE_POLL_SECONDS=2

# Gunicorn
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
LOG_LEVEL=info

# Binários
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp

# Chaves de API (opcional — o ideal é cadastrar pela aba "Central de APIs")
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# ELEVENLABS_API_KEY=
