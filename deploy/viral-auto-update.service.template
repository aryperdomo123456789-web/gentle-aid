[Unit]
Description=Ecossistema Viral - Auto update watcher - __DOMAIN__
After=network.target

[Service]
Type=oneshot
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__
Environment="VIRAL_ROOT=__APP_DIR__"
EnvironmentFile=-__APP_DIR__/.env
ExecStart=/usr/bin/env bash __APP_DIR__/deploy/auto-update.sh

